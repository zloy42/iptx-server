# IPTX Server Configuration
# Copy this to .env and edit

# Server port
PORT=3000

# Server public URL (for Xtream API response)
SERVER_URL=http://localhost:3000

# Users: format "user1:pass1,user2:pass2"
USERS=admin:admin123

# M3U source (use one):
# Option A: URL to remote M3U playlist
M3U_URL=

# Option B: Local file path
M3U_FILE=‪C:\Users\KEN\Desktop\IPTV\nasional.m3u
